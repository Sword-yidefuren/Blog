---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const firstPost = posts.at(-1);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 820px;
				padding: 3em 1em 3.5em;
			}
			.list-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin: 0 0 1.2em;
				padding-bottom: 0.75em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.list-head h1 {
				margin: 0;
				font-size: 1.02em;
				font-weight: 700;
				letter-spacing: 0.04em;
			}
			.list-head span {
				color: rgb(var(--gray));
				font-size: 0.84em;
			}
			@media (max-width: 720px) {
				main {
					padding: 2em 1em 2.5em;
				}
				.list-head {
					flex-wrap: wrap;
					gap: 0.3em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="list-head">
				<h1>文章</h1>
				<span>
					{posts.length} 篇 · 从 {firstPost?.data.pubDate.getFullYear()} 年
					{firstPost ? firstPost.data.pubDate.getMonth() + 1 : ''} 月开始
				</span>
			</div>
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>
