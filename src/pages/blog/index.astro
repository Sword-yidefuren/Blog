---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { readingTime } from '../../utils/readingTime';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const shortDate = (date: Date) => `${date.getMonth() + 1} 月 ${date.getDate()} 日`;
const firstPost = posts.at(-1);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 820px;
				padding: 3em 1em 3.5em;
			}
			.list-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin: 0 0 0.4em;
				padding-bottom: 0.75em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.list-head h1 {
				margin: 0;
				font-size: 1.02em;
				font-weight: 700;
				letter-spacing: 0.04em;
			}
			.list-head span {
				color: rgb(var(--gray));
				font-size: 0.84em;
			}
			.posts {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.posts li + li {
				border-top: 1px solid rgb(var(--gray-light));
			}
			.posts a {
				display: grid;
				grid-template-columns: 5.4em 1fr 4.2em;
				gap: 0 1.4em;
				align-items: baseline;
				padding: 1.05em 0;
				text-decoration: none;
			}
			.when {
				color: rgb(var(--gray));
				font-size: 0.8em;
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}
			.title {
				display: block;
				color: rgb(var(--black));
				font-size: 1.06em;
				font-weight: 700;
				line-height: 1.45;
				transition: color 0.2s ease;
			}
			.desc {
				display: -webkit-box;
				overflow: hidden;
				margin: 0.3em 0 0;
				color: rgb(var(--gray));
				font-size: 0.88em;
				line-height: 1.6;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 1;
			}
			.mins {
				color: rgb(var(--gray));
				font-size: 0.78em;
				text-align: right;
				white-space: nowrap;
			}
			.posts a:hover .title,
			.posts a:hover .when {
				color: var(--accent-text);
			}
			@media (max-width: 720px) {
				main {
					padding: 2em 1em 2.5em;
				}
				.list-head {
					flex-wrap: wrap;
					gap: 0.3em;
				}
				.posts a {
					grid-template-columns: 1fr;
					gap: 0.25em;
					padding: 0.95em 0;
				}
				.mins {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="list-head">
				<h1>文章</h1>
				<span>
					{posts.length} 篇 · 从 {firstPost?.data.pubDate.getFullYear()} 年
					{firstPost ? firstPost.data.pubDate.getMonth() + 1 : ''} 月开始
				</span>
			</div>
			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<time class="when" datetime={post.data.pubDate.toISOString()}>
									{shortDate(post.data.pubDate)}
								</time>
								<span>
									<span class="title">{post.data.title}</span>
									<span class="desc">{post.data.description}</span>
								</span>
								<span class="mins">{readingTime(post.body)} 分钟</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
