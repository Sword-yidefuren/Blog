---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const allTags = new Set(posts.flatMap((post) => post.data.tags));
	return [...allTags].map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts
				.filter((post) => post.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;

// 顶部标签切换：全部（/blog）+ 每个标签
const allPosts = await getCollection('blog');
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort((a, b) =>
	a.localeCompare(b, 'zh-CN'),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`标签：${tag} | ${SITE_TITLE}`} description={`标签「${tag}」下的全部文章`} />
		<style>
			main {
				width: 820px;
				padding: 3em 1em 3.5em;
			}
			.list-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin: 0 0 0.4em;
				padding-bottom: 0.75em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.list-head h1 {
				margin: 0;
				font-size: 1.02em;
				font-weight: 700;
				letter-spacing: 0.04em;
			}
			.list-head span {
				color: rgb(var(--gray));
				font-size: 0.84em;
			}
			.tag-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin: 1.4em 0 0.4em;
			}
			.tag-nav .tag {
				padding: 0.3em 0.9em;
				font-size: 0.84em;
			}
			.tag-nav .tag.active {
				background: var(--accent);
				border-color: var(--accent);
				color: #082f33;
			}
			@media (max-width: 720px) {
				main {
					padding: 2em 1em 2.5em;
				}
				.list-head {
					flex-wrap: wrap;
					gap: 0.3em;
				}
				/* 手机上标签多时允许横向滑，不要挤成三行 */
				.tag-nav {
					flex-wrap: nowrap;
					overflow-x: auto;
					padding-bottom: 0.3em;
					-webkit-overflow-scrolling: touch;
				}
				.tag-nav .tag {
					flex: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="list-head">
				<h1>标签：{tag}</h1>
				<span>{posts.length} 篇</span>
			</div>
			<nav class="tag-nav" aria-label="按标签浏览">
				<a class="tag" href="/blog/">全部</a>
				{
					tags.map((item) => (
						<a
							class="tag"
							class:list={[{ active: item === tag }]}
							href={`/tags/${item}/`}
							aria-current={item === tag ? 'page' : undefined}
						>
							{item}
						</a>
					))
				}
			</nav>
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>
