---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

// 按标签分组；组内按时间倒序，组间按篇数从多到少
const groups = new Map<string, typeof posts>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		const list = groups.get(tag) ?? [];
		list.push(post);
		groups.set(tag, list);
	}
}
const sections = [...groups.entries()]
	.map(([tag, list]) => ({
		tag,
		posts: [...list].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
	}))
	.sort((a, b) => b.posts.length - a.posts.length || a.tag.localeCompare(b.tag, 'zh-CN'));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`标签 | ${SITE_TITLE}`} description="按标签浏览所有文章" />
		<style>
			main {
				width: 820px;
				padding: 3em 1em 3.5em;
			}
			.list-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin: 0 0 0.4em;
				padding-bottom: 0.75em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.list-head h1 {
				margin: 0;
				font-size: 1.02em;
				font-weight: 700;
				letter-spacing: 0.04em;
			}
			.list-head span {
				color: rgb(var(--gray));
				font-size: 0.84em;
			}
			.tag-group {
				margin-top: 2.4em;
			}
			.tag-group h2 {
				display: flex;
				align-items: baseline;
				gap: 0.6em;
				margin: 0;
				padding-bottom: 0.6em;
				border-bottom: 1px solid rgb(var(--gray-light));
				font-size: 1.06em;
			}
			.tag-group h2 a {
				text-decoration: none;
			}
			.tag-group h2 a:hover {
				color: var(--accent-text);
			}
			.tag-group .count {
				color: rgb(var(--gray));
				font-size: 0.8em;
				font-weight: 400;
			}
			@media (max-width: 720px) {
				main {
					padding: 2em 1em 2.5em;
				}
				.list-head {
					flex-wrap: wrap;
					gap: 0.3em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="list-head">
				<h1>标签</h1>
				<span>{sections.length} 个标签 · {posts.length} 篇文章</span>
			</div>
			{
				sections.map((section) => (
					<section class="tag-group">
						<h2>
							<a href={`/tags/${section.tag}/`}>{section.tag}</a>
							<span class="count">{section.posts.length} 篇</span>
						</h2>
						<PostList posts={section.posts} />
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
