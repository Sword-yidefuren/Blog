---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const groups = new Map<string, typeof posts>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		const list = groups.get(tag) ?? [];
		list.push(post);
		groups.set(tag, list);
	}
}
const sections = [...groups.entries()]
	.map(([tag, list]) => ({
		tag,
		posts: [...list].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
	}))
	.sort((a, b) => b.posts.length - a.posts.length || a.tag.localeCompare(b.tag, 'zh-CN'));
---

<html lang="zh-CN">
	<head>
		<BaseHead title={`标签 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			h1 {
				margin-bottom: 1em;
			}
			.index {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.index a {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.35em 0.9em;
				border: 1px solid rgba(34, 211, 238, 50%);
				border-radius: 999px;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.index a:hover {
				background: var(--accent);
				border-color: var(--accent);
				color: #082f33;
			}
			.count {
				color: rgb(var(--gray));
				font-size: 0.8em;
			}
			.index a:hover .count {
				color: #082f33;
			}
			.tag-group {
				margin-top: 2.5em;
				scroll-margin-top: 4em;
			}
			.tag-group h2 {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin: 0 0 0.6em;
				font-size: 1.3em;
			}
			.posts {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.posts li {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				padding: 0.5em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.posts li:last-child {
				border-bottom: 0;
			}
			.posts a {
				text-decoration: none;
			}
			.posts a:hover {
				color: var(--accent-text);
			}
			.posts .date {
				color: rgb(var(--gray));
				font-size: 0.85em;
				white-space: nowrap;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>标签</h1>
			<ul class="index">
				{
					sections.map(({ tag, posts }) => (
						<li>
							<a href={`#tag-${tag}`}>
								{tag}
								<span class="count">{posts.length}</span>
							</a>
						</li>
					))
				}
			</ul>
			{
				sections.map(({ tag, posts }) => (
					<section class="tag-group" id={`tag-${tag}`}>
						<h2>
							<a class="tag" href={`/tags/${tag}/`}>
								{tag}
							</a>
							<span class="count">{posts.length} 篇</span>
						</h2>
						<ul class="posts">
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
