---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links" id="site-nav">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/tags">标签</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="nav-actions">
			<div class="social-links">
				<a href="https://github.com/Sword-yidefuren" target="_blank">
					<span class="sr-only">看哥的GitHub仓库</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
			</div>
			<button type="button" class="theme-toggle" aria-label="切换深色模式" title="切换深色模式">
				<svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
					><path fill="currentColor" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
				>
				<svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
					><circle cx="12" cy="12" r="4" fill="currentColor"></circle><g
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</g></svg
				>
			</button>
			<button
				type="button"
				class="menu-btn"
				aria-label="打开菜单"
				aria-expanded="false"
				aria-controls="site-nav"
			>
				<span></span><span></span><span></span>
			</button>
		</div>
	</nav>
</header>
<style>
	header {
		position: relative;
		margin: 0;
		padding: 0 1em;
		background: var(--header-bg);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.4em;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.2em;
		height: 2.2em;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: rgb(var(--gray));
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--accent);
	}
	.internal-links {
		display: flex;
	}
	.menu-btn {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 44px;
		height: 44px;
		padding: 0 11px;
		border: 0;
		border-radius: 8px;
		background: none;
		color: rgb(var(--gray));
		cursor: pointer;
	}
	.menu-btn span {
		display: block;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: 0.2s ease;
	}
	.menu-btn.open span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.menu-btn.open span:nth-child(2) {
		opacity: 0;
	}
	.menu-btn.open span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		.menu-btn {
			display: inline-flex;
		}
		.theme-toggle {
			width: 44px;
			height: 44px;
		}
		.internal-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			padding: 0.4em 0;
			background: var(--header-bg);
			box-shadow: 0 8px 24px rgba(0, 0, 0, 12%);
			z-index: 30;
		}
		.internal-links.open {
			display: flex;
		}
		.internal-links a {
			display: flex;
			align-items: center;
			min-height: 44px;
			padding: 0.85em 1.2em;
			border-bottom: 0;
		}
		.internal-links a.active {
			border-bottom: 0;
			box-shadow: inset 3px 0 0 var(--accent);
		}
	}
</style>
<script>
	const root = document.documentElement;
	document.querySelector('.theme-toggle')?.addEventListener('click', () => {
		const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = theme;
		try {
			localStorage.setItem('theme', theme);
		} catch {
			// 存储不可用时仅本次会话生效
		}
	});

	// 移动端汉堡菜单
	const menuBtn = document.querySelector('.menu-btn');
	const navPanel = document.querySelector('.internal-links');
	const closeMenu = () => {
		if (!menuBtn || !navPanel) return;
		navPanel.classList.remove('open');
		menuBtn.classList.remove('open');
		menuBtn.setAttribute('aria-expanded', 'false');
	};
	menuBtn?.addEventListener('click', () => {
		if (!navPanel) return;
		const open = navPanel.classList.toggle('open');
		menuBtn.classList.toggle('open', open);
		menuBtn.setAttribute('aria-expanded', String(open));
	});
	navPanel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});
	document.addEventListener('click', (event) => {
		if (!navPanel?.classList.contains('open')) return;
		const target = event.target;
		if (target instanceof Element && (target.closest('.internal-links') || target.closest('.menu-btn'))) {
			return;
		}
		closeMenu();
	});
</script>
