---
const today = new Date();

// 页脚每次刷新随机一句；没有 JS 时固定显示第一句
const lines = [
	'今天也谢谢你翻到这里',
	'院子不大，慢慢逛',
	'这里不常有新东西，但每次都是真的',
	'写的时候很认真，看得时候随意就好',
	'鼠标可以歇一会儿了',
	'有想法，QQ 或微信找我就行',
	'天黑了就开深色模式吧',
	'下一篇文章还在脑子里排队',
	'能读到页脚，说明你是真朋友',
	'祝你今天不加班，或者少加一点',
	'这里只有一个人在写，和一个人在等',
	'好了，该去干正事了',
];
---

<footer>
	<p class="line" id="footer-line" data-lines={JSON.stringify(lines)}>{lines[0]}</p>
	<p class="copyright"
		>&copy; {today.getFullYear()} Sword<button
			type="button"
			id="sound-toggle"
			class="sound-toggle"
			aria-pressed="false"
			aria-label="声音开关"
			title="声音：关"><span class="note">♪</span></button
		></p
	>
	<div class="social-links">
		<a href="https://github.com/Sword-yidefuren" target="_blank">
			<span class="sr-only">哥的GitHub仓库</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32" astro-icon="social/github"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
		</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.line {
		margin: 0 0 0.4em;
		min-height: 1.6em;
		color: rgb(var(--gray-dark));
		font-size: 0.86em;
	}
	.copyright {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.76em;
	}
	/* 声音开关：关着时一道斜线，开着转青 */
	.sound-toggle {
		position: relative;
		display: inline-grid;
		place-items: center;
		width: 1.9em;
		height: 1.9em;
		margin-left: 0.45em;
		padding: 0;
		vertical-align: middle;
		font-family: inherit;
		font-size: 1em;
		line-height: 1;
		color: rgb(var(--gray));
		background: transparent;
		border: 1px solid transparent;
		border-radius: 50%;
		cursor: pointer;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.sound-toggle .note {
		display: block;
		transform: translateY(-0.02em);
		transition:
			transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1),
			opacity 0.2s ease;
	}
	.sound-toggle::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 1px;
		height: 1.15em;
		background: currentColor;
		transform: translate(-50%, -50%) rotate(45deg);
		opacity: 0.75;
		transition:
			opacity 0.2s ease,
			transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1);
	}
	.sound-toggle:hover {
		color: rgb(var(--gray-dark));
		border-color: rgb(var(--gray-light));
	}
	.sound-toggle[aria-pressed='true'] {
		color: var(--accent-text);
	}
	.sound-toggle[aria-pressed='true']::after {
		opacity: 0;
		transform: translate(-50%, -50%) rotate(45deg) scale(0.4);
	}
	.sound-toggle[aria-pressed='true'] .note {
		transform: translateY(-0.08em) scale(1.06);
	}
	@media (prefers-reduced-motion: reduce) {
		.sound-toggle,
		.sound-toggle .note,
		.sound-toggle::after {
			transition: none;
		}
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
<script>
	import { mountSoundToggle } from '../scripts/sound';

	// 页脚随机句：每次刷新换一句（没 JS 时保留构建时那句）
	const footerLine = document.getElementById('footer-line');
	if (footerLine) {
		try {
			const pool = JSON.parse(footerLine.dataset.lines || '[]');
			if (Array.isArray(pool) && pool.length > 1) {
				footerLine.textContent = pool[Math.floor(Math.random() * pool.length)];
			}
		} catch {
			/* 数据坏了就保持原句 */
		}
	}

	const soundToggle = document.getElementById('sound-toggle');
	if (soundToggle instanceof HTMLButtonElement) mountSoundToggle(soundToggle);
</script>
