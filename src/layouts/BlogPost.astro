---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { readingTime } from '../utils/readingTime';

type TocItem = { slug: string; text: string; level: 1 | 2 };

type Props = CollectionEntry<'blog'>['data'] & {
	body?: string;
	prev?: { id: string; title: string } | null;
	next?: { id: string; title: string } | null;
	toc?: TocItem[];
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], prev, next, toc = [] } = Astro.props;
const minutes = readingTime(Astro.props.body);
// 太短的文章不放目录（默认 3 条起）
const showToc = toc.length >= 3;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				author: { '@type': 'Person', name: 'Sword' },
				mainEntityOfPage: Astro.url.href,
			})}
		></script>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 750px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 0 1em 1em;
				color: rgb(var(--gray-dark));
			}
			/* 标题块从 .prose 里拆出来，手机端目录才能插在「标题之后、正文之前」 */
			.article-head {
				width: 750px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em 1em 0;
			}
			.article-body {
				display: block;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.reading-time {
				font-size: 0.9em;
				color: rgb(var(--gray));
				margin-top: 0.2em;
			}
			.last-updated-on {
				font-style: italic;
			}

			/* ---------- 文章目录 ---------- */
			.toc {
				width: 750px;
				max-width: calc(100% - 2em);
				margin: 1.4em auto;
				padding: 0 1em;
				font-size: 0.88em;
			}
			.toc details {
				padding: 0.7em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: rgb(var(--header-bg));
			}
			.toc summary {
				color: rgb(var(--gray-dark));
				font-weight: 700;
				line-height: 1.6;
				cursor: pointer;
			}
			.toc summary::marker {
				color: var(--accent);
			}
			.toc ol {
				list-style: none;
				margin: 0.5em 0 0.2em;
				padding: 0;
				border-left: 1px solid rgb(var(--gray-light));
			}
			.toc li a {
				display: block;
				margin-left: -1px;
				padding: 0.35em 0 0.35em 0.9em;
				border-left: 2px solid transparent;
				color: rgb(var(--gray));
				line-height: 1.5;
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.toc li.lvl-2 a {
				padding-left: 1.8em;
				font-size: 0.94em;
			}
			.toc li a:hover {
				color: var(--accent-text);
			}
			.toc li a.active {
				border-left-color: var(--accent);
				color: var(--accent-text);
			}
			/* 锚点跳转别被贴顶的标题挡住 */
			.prose :is(h2, h3, h4, h5, h6) {
				scroll-margin-top: 2em;
			}

			@media (min-width: 1120px) {
				.article-body {
					display: grid;
					grid-template-columns: 782px 220px;
					gap: 0 2.8em;
					justify-content: center;
					align-items: start;
				}
				.article-head {
					grid-column: 1;
					grid-row: 1;
					width: auto;
					max-width: none;
					margin: 0;
				}
				.prose {
					grid-column: 1;
					grid-row: 2;
					width: auto;
					max-width: none;
					margin: 0;
				}
				.toc {
					grid-column: 2;
					grid-row: 1 / span 2;
					position: sticky;
					top: 2.5em;
					width: auto;
					max-width: none;
					margin: 3.6em 0 0;
					padding: 0;
					font-size: 0.82em;
				}
				.toc details {
					padding: 0;
					border: 0;
					border-radius: 0;
					background: none;
				}
				.toc summary {
					display: none;
				}
				.toc ol {
					margin: 0;
				}
				.toc li a {
					padding-top: 0.4em;
					padding-bottom: 0.4em;
				}
			}

			@media print {
				.toc {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="article-body">
					<div class="article-head">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{minutes > 0 && (
									<div class="reading-time">
										约 {minutes} 分钟
									</div>
								)}
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
							{
								tags.length > 0 && (
									<div class="post-tags">
										{tags.map((tag) => (
											<a class="tag" href={`/tags/${tag}/`}>
												{tag}
											</a>
										))}
									</div>
								)
							}
						</div>
					</div>
					{
						showToc && (
							<aside class="toc" aria-label="文章目录">
								<details open>
									<summary>本文目录</summary>
									<ol>
										{toc.map((item) => (
											<li class:list={[`lvl-${item.level}`]}>
												<a href={`#${item.slug}`}>{item.text}</a>
											</li>
										))}
									</ol>
								</details>
							</aside>
						)
					}
					<div class="prose">
					<slot />
					{
						(prev || next) && (
							<nav class="post-nav" aria-label="上一篇与下一篇">
								{prev ? (
									<a class="prev" href={`/blog/${prev.id}/`}>
										<span class="dir">← 上一篇</span>
										<strong>{prev.title}</strong>
									</a>
								) : (
									<span />
								)}
								{next ? (
									<a class="next" href={`/blog/${next.id}/`}>
										<span class="dir">下一篇 →</span>
										<strong>{next.title}</strong>
									</a>
								) : (
									<span />
								)}
							</nav>
						)
					}
					</div>
				</div>
			</article>
		</main>
		<Footer />
		<script>
			// 阅读续读：按滚动比例记录/恢复每篇文章的阅读进度
			const key = `readpos:${location.pathname}`;
			const store = {
				get() {
					try {
						return localStorage.getItem(key);
					} catch {
						return null;
					}
				},
				set(value) {
					try {
						localStorage.setItem(key, value);
					} catch {
						/* 存储不可用时忽略 */
					}
				},
				clear() {
					try {
						localStorage.removeItem(key);
					} catch {
						/* 同上 */
					}
				},
			};

			// 避免浏览器自带的滚动恢复与续读打架
			if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

			const saved = parseFloat(store.get() ?? '');
			if (!Number.isNaN(saved) && saved > 0.02 && saved < 0.95) {
				requestAnimationFrame(() => {
					const max = document.documentElement.scrollHeight - window.innerHeight;
					if (max > 0) {
						window.scrollTo({ top: saved * max, behavior: 'auto' });
						showResumeToast();
					}
				});
			}

			let timer = 0;
			const save = () => {
				const max = document.documentElement.scrollHeight - window.innerHeight;
				if (max <= 0) return;
				const ratio = window.scrollY / max;
				// 读到 95% 以上视为读完，清空记录，下次从头开始
				if (ratio > 0.95) store.clear();
				else if (ratio > 0.02) store.set(String(ratio));
			};
			window.addEventListener(
				'scroll',
				() => {
					clearTimeout(timer);
					timer = window.setTimeout(save, 300);
				},
				{ passive: true },
			);
			window.addEventListener('pagehide', save);

			function showResumeToast() {
				const toast = document.createElement('div');
				toast.className = 'read-resume-toast';
				const text = document.createElement('span');
				text.textContent = '已回到上次阅读位置';
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.textContent = '从头开始';
				btn.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
					toast.remove();
				});
				toast.append(text, btn);
				document.body.appendChild(toast);
				window.setTimeout(() => toast.remove(), 6000);
			}

			// 回到顶部按钮：滚过一屏后出现
			const backTop = document.createElement('button');
			backTop.type = 'button';
			backTop.className = 'back-to-top';
			backTop.setAttribute('aria-label', '回到顶部');
			backTop.textContent = '↑';
			document.body.appendChild(backTop);
			const syncBackTop = () => backTop.classList.toggle('show', window.scrollY > 600);
			window.addEventListener('scroll', syncBackTop, { passive: true });
			syncBackTop();
			backTop.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// 图片灯箱：点正文里的图片放大，点任意处或 Esc 关闭
			let lightbox = null;
			document.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof HTMLImageElement)) return;
				if (!target.closest('.prose')) return;
				lightbox?.remove();
				const overlay = document.createElement('div');
				overlay.className = 'lightbox';
				overlay.setAttribute('role', 'dialog');
				overlay.setAttribute('aria-label', '查看大图');
				const big = new Image();
				big.src = target.currentSrc || target.src;
				big.alt = target.alt;
				overlay.appendChild(big);
				overlay.addEventListener('click', () => overlay.remove());
				document.body.appendChild(overlay);
				requestAnimationFrame(() => overlay.classList.add('show'));
				lightbox = overlay;
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					lightbox?.remove();
					lightbox = null;
				}
			});

			// 文章目录：桌面固定展开，窄屏收进 <details>；滚动时高亮当前小节
			const toc = document.querySelector('.toc');
			const tocDetails = toc?.querySelector('details');
			const wideToc = window.matchMedia('(min-width: 1120px)');
			const syncTocOpen = () => {
				if (tocDetails) tocDetails.open = wideToc.matches;
			};
			syncTocOpen();
			wideToc.addEventListener('change', syncTocOpen);

			const tocTargets = Array.from(toc?.querySelectorAll('a[href^="#"]') ?? [])
				.map((link) => {
					const id = decodeURIComponent(link.getAttribute('href').slice(1));
					const heading = document.getElementById(id);
					return heading ? { link, heading } : null;
				})
				.filter(Boolean);

			if (tocTargets.length) {
				let current = -1;
				const markActive = () => {
					let index = 0;
					tocTargets.forEach((item, i) => {
						if (item.heading.getBoundingClientRect().top <= 120) index = i;
					});
					if (index === current) return;
					current = index;
					tocTargets.forEach((item, i) => item.link.classList.toggle('active', i === index));
				};

				let queued = false;
				window.addEventListener(
					'scroll',
					() => {
						if (queued) return;
						queued = true;
						requestAnimationFrame(() => {
							markActive();
							queued = false;
						});
					},
					{ passive: true },
				);
				markActive();
			}
		</script>
	</body>
</html>
