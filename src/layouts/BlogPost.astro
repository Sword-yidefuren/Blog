---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { readingTime } from '../utils/readingTime';

type TocItem = { slug: string; text: string; level: 1 | 2 };

type Props = CollectionEntry<'blog'>['data'] & {
	body?: string;
	prev?: { id: string; title: string } | null;
	next?: { id: string; title: string } | null;
	toc?: TocItem[];
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], prev, next, toc = [] } = Astro.props;
const minutes = readingTime(Astro.props.body);
// 太短的文章不放目录（默认 3 条起）
const showToc = toc.length >= 3;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				author: { '@type': 'Person', name: 'Sword' },
				mainEntityOfPage: Astro.url.href,
			})}
		></script>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				position: relative;
				width: 750px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 0 1em 1em;
				color: rgb(var(--gray-dark));
			}
			/* 标题块从 .prose 里拆出来，手机端目录才能插在「标题之后、正文之前」 */
			.article-head {
				width: 750px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em 1em 0;
			}
			.article-body {
				display: block;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.reading-time {
				font-size: 0.9em;
				color: rgb(var(--gray));
				margin-top: 0.2em;
			}
			.last-updated-on {
				font-style: italic;
			}

			/* ---------- 文章目录 ---------- */
			.toc {
				width: 750px;
				max-width: calc(100% - 2em);
				margin: 1.4em auto;
				padding: 0 1em;
				font-size: 0.88em;
			}
			.toc details {
				padding: 0.7em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: rgb(var(--header-bg));
			}
			.toc summary {
				color: rgb(var(--gray-dark));
				font-weight: 700;
				line-height: 1.6;
				cursor: pointer;
			}
			.toc summary::marker {
				color: var(--accent);
			}
			.toc ol {
				list-style: none;
				margin: 0.5em 0 0.2em;
				padding: 0;
				border-left: 1px solid rgb(var(--gray-light));
			}
			.toc li a {
				display: block;
				margin-left: -1px;
				padding: 0.35em 0 0.35em 0.9em;
				border-left: 2px solid transparent;
				color: rgb(var(--gray));
				line-height: 1.5;
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.toc li.lvl-2 a {
				padding-left: 1.8em;
				font-size: 0.94em;
			}
			.toc li a:hover {
				color: var(--accent-text);
			}
			.toc li a.active {
				border-left-color: var(--accent);
				color: var(--accent-text);
			}
			/* 锚点跳转别被贴顶的标题挡住 */
			.prose :is(h2, h3, h4, h5, h6) {
				scroll-margin-top: 2em;
			}

			/* ---------- 左侧刻度目录 ---------- */
			.toc-tick {
				display: none;
				position: fixed;
				left: calc(50% - 375px - 76px);
				top: 50%;
				transform: translateY(-50%);
				z-index: 20;
			}
			.toc-tick ol {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: 10px;
				position: relative;
			}
			/* 轨道：一条极淡的竖线，刻度从它向左伸出 */
			.toc-tick ol::after {
				content: '';
				position: absolute;
				right: 0;
				top: 1px;
				bottom: 1px;
				width: 1px;
				background: rgb(var(--gray-light));
			}
			.toc-tick li {
				position: relative;
				z-index: 1;
			}
			.toc-tick a {
				display: flex;
				align-items: center;
				justify-content: flex-end;
				position: relative;
			}
			.tick {
				display: block;
				height: 2px;
				border-radius: 2px;
				background: rgb(var(--gray-light));
				transition:
					width 0.2s ease,
					background 0.2s ease;
			}
			.lvl-1 .tick {
				width: 16px;
			}
			.lvl-2 .tick {
				width: 10px;
			}
			.toc-tick a:hover .tick,
			.toc-tick a.active .tick {
				background: var(--accent);
			}
			.lvl-1 a.active .tick {
				width: 20px;
			}
			.lvl-2 a.active .tick {
				width: 14px;
			}
			/* 悬停/聚焦才浮出标题 */
			.toc-tick .label {
				position: absolute;
				right: 100%;
				margin-right: 12px;
				padding: 0.2em 0.6em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--header-bg);
				color: rgb(var(--gray-dark));
				font-size: 0.76em;
				line-height: 1.6;
				white-space: nowrap;
				opacity: 0;
				transform: translateX(4px);
				transition:
					opacity 0.18s ease,
					transform 0.18s ease;
				pointer-events: none;
			}
			.toc-tick a:hover .label,
			.toc-tick a:focus-visible .label {
				opacity: 1;
				transform: none;
			}
			/* 小球：贴在当前小节标题的左边，小节切换时跳过去（落点带一点回弹）
			   手机上也给：手机正文两侧只有 15px 留白，球缩到 10px 塞进这条缝里 */
			.heading-ball {
				display: block;
				position: absolute;
				left: -6px;
				top: 0;
				width: 10px;
				height: 10px;
				transform: translateY(0);
				transition: transform 0.34s cubic-bezier(0.34, 1.56, 0.64, 1);
				pointer-events: none;
				z-index: 2;
			}
			.ball-dot {
				display: block;
				width: 100%;
				height: 100%;
				border-radius: 50%;
				background: var(--accent);
				box-shadow: 0 0 0 5px rgba(34, 211, 238, 10%);
				transform-origin: 50% 100%;
			}
			/* 落地那一下：压扁 → 弹起 → 归位 */
			.ball-dot.bounce {
				animation: ball-bounce 0.42s cubic-bezier(0.3, 0.7, 0.4, 1);
			}
			@keyframes ball-bounce {
				0% {
					transform: scale(1);
				}
				35% {
					transform: scale(1.35, 0.72) translateY(2px);
				}
				65% {
					transform: scale(0.92, 1.12) translateY(-1px);
				}
				100% {
					transform: scale(1);
				}
			}
			@media (min-width: 1200px) {
				.heading-ball {
					left: -2px;
					width: 12px;
					height: 12px;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.heading-ball {
					transition: none;
				}
				.ball-dot.bounce {
					animation: none;
				}
			}

			/* 宽屏才启用刻度目录：正文回到单列居中，刻度浮在左侧留白里；
			   同时撤掉顶部进度条，任何宽度下只留一个进度指示 */
			@media (min-width: 1200px) {
				.toc {
					display: none;
				}
				.toc-tick {
					display: block;
				}
				.read-progress {
					display: none;
				}
			}

			/* ---------- 阅读进度条 ---------- */
			.read-progress {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 2px;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: 0 50%;
				z-index: 40;
			}

			/* ---------- 字号调节：2026-11-03 已去掉（和回顶按钮抢右下角，用户也觉得没必要） ---------- */

			@media print {
				.toc,
				.read-progress {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<div class="read-progress" aria-hidden="true"></div>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="article-body">
					<div class="article-head">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{minutes > 0 && (
									<div class="reading-time">
										约 {minutes} 分钟
									</div>
								)}
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
							{
								tags.length > 0 && (
									<div class="post-tags">
										{tags.map((tag) => (
											<a class="tag" href={`/tags/${tag}/`}>
												{tag}
											</a>
										))}
									</div>
								)
							}
						</div>
					</div>
					{
						showToc && (
							<aside class="toc" aria-label="文章目录">
								<details open>
									<summary>本文目录</summary>
									<ol>
										{toc.map((item) => (
											<li class:list={[`lvl-${item.level}`]}>
												<a href={`#${item.slug}`}>{item.text}</a>
											</li>
										))}
									</ol>
								</details>
							</aside>
						)
					}
					{
						showToc && (
							<nav class="toc-tick" aria-label="文章目录（刻度）">
								<ol>
									{toc.map((item) => (
										<li class:list={[`lvl-${item.level}`]}>
											<a href={`#${item.slug}`} aria-label={`跳到：${item.text}`}>
												<span class="tick" aria-hidden="true" />
												<span class="label" aria-hidden="true">
													{item.text}
												</span>
											</a>
										</li>
									))}
								</ol>
							</nav>
						)
					}
					<div class="prose">
					{showToc && (
						<span class="heading-ball" aria-hidden="true">
							<span class="ball-dot" />
						</span>
					)}
					<slot />
					{
						(prev || next) && (
							<nav class="post-nav" aria-label="上一篇与下一篇">
								{prev ? (
									<a class="prev" href={`/blog/${prev.id}/`}>
										<span class="dir">← 上一篇</span>
										<strong>{prev.title}</strong>
									</a>
								) : (
									<span />
								)}
								{next ? (
									<a class="next" href={`/blog/${next.id}/`}>
										<span class="dir">下一篇 →</span>
										<strong>{next.title}</strong>
									</a>
								) : (
									<span />
								)}
							</nav>
						)
					}
					</div>
				</div>
			</article>
		</main>
		<Footer />
		<script>
			import { playCue } from '../scripts/sound';

			// 阅读续读：按滚动比例记录/恢复每篇文章的阅读进度
			const key = `readpos:${location.pathname}`;
			const store = {
				get() {
					try {
						return localStorage.getItem(key);
					} catch {
						return null;
					}
				},
				set(value) {
					try {
						localStorage.setItem(key, value);
					} catch {
						/* 存储不可用时忽略 */
					}
				},
				clear() {
					try {
						localStorage.removeItem(key);
					} catch {
						/* 同上 */
					}
				},
			};

			// 避免浏览器自带的滚动恢复与续读打架
			if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

			const saved = parseFloat(store.get() ?? '');
			if (!Number.isNaN(saved) && saved > 0.02 && saved < 0.95) {
				requestAnimationFrame(() => {
					const max = document.documentElement.scrollHeight - window.innerHeight;
					if (max > 0) {
						window.scrollTo({ top: saved * max, behavior: 'auto' });
						showResumeToast();
					}
				});
			}

			let timer = 0;
			const save = () => {
				const max = document.documentElement.scrollHeight - window.innerHeight;
				if (max <= 0) return;
				const ratio = window.scrollY / max;
				// 读到 95% 以上视为读完，清空记录，下次从头开始
				if (ratio > 0.95) store.clear();
				else if (ratio > 0.02) store.set(String(ratio));
			};
			window.addEventListener(
				'scroll',
				() => {
					clearTimeout(timer);
					timer = window.setTimeout(save, 300);
				},
				{ passive: true },
			);
			window.addEventListener('pagehide', save);

			function showResumeToast() {
				const toast = document.createElement('div');
				toast.className = 'read-resume-toast';
				const text = document.createElement('span');
				text.textContent = '已回到上次阅读位置';
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.textContent = '从头开始';
				btn.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
					toast.remove();
				});
				toast.append(text, btn);
				document.body.appendChild(toast);
				window.setTimeout(() => toast.remove(), 6000);
			}

			// 回到顶部按钮：滚过一屏出现；第一次滚到最底部时涨成圆形鲸鱼娘循环图，之后一直保留
			const backTop = document.createElement('button');
			backTop.type = 'button';
			backTop.className = 'back-to-top';
			backTop.setAttribute('aria-label', '回到顶部');
			backTop.title = '回到顶部';
			const arrow = document.createElement('span');
			arrow.className = 'bt-arrow';
			arrow.setAttribute('aria-hidden', 'true');
			arrow.textContent = '↑';
			const whale = document.createElement('img');
			whale.className = 'bt-whale';
			whale.alt = '';
			whale.setAttribute('aria-hidden', 'true');
			whale.decoding = 'async';
			backTop.append(arrow, whale);
			document.body.appendChild(backTop);

			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			// 快到底时才下载；开了「减弱动态效果」就只显示首帧，不播动画
			const WHALE_ANIM = '/images/ui/whale-loop-v1.webp';
			const WHALE_STILL = '/images/ui/whale-loop-v1.png';
			let whaleLoaded = false;
			let whaleShown = false;
			const loadWhale = () => {
				if (whaleLoaded) return;
				whaleLoaded = true;
				whale.src = reducedMotion.matches ? WHALE_STILL : WHALE_ANIM;
			};

			let backTopFrame = 0;
			const syncBackTop = () => {
				backTopFrame = 0;
				const max = document.documentElement.scrollHeight - window.innerHeight;
				const ratio = max > 0 ? window.scrollY / max : 0;
				backTop.classList.toggle('show', window.scrollY > 600);
				// 到底一次就长期保留：回滚也不收回、不停
				if (!whaleShown) {
					if (max > 0 && ratio >= 0.98) {
						whaleShown = true;
						loadWhale();
						backTop.classList.add('is-whale');
					} else if (max > 0 && ratio > 0.5) {
						loadWhale();
					}
				}
			};
			// 一帧最多算一次，不跟着每个 scroll 事件读布局
			const queueBackTop = () => {
				if (backTopFrame) return;
				backTopFrame = requestAnimationFrame(syncBackTop);
			};
			window.addEventListener('scroll', queueBackTop, { passive: true });
			window.addEventListener('resize', queueBackTop);
			syncBackTop();
			backTop.addEventListener('click', () => {
				playCue('top');
				window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
			});

			// 图片灯箱：点正文里的图片放大，点任意处或 Esc 关闭
			let lightbox = null;
			document.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof HTMLImageElement)) return;
				if (!target.closest('.prose')) return;
				lightbox?.remove();
				const overlay = document.createElement('div');
				overlay.className = 'lightbox';
				overlay.setAttribute('role', 'dialog');
				overlay.setAttribute('aria-label', '查看大图');
				const big = new Image();
				big.src = target.currentSrc || target.src;
				big.alt = target.alt;
				overlay.appendChild(big);
				overlay.addEventListener('click', () => overlay.remove());
				document.body.appendChild(overlay);
				requestAnimationFrame(() => overlay.classList.add('show'));
				lightbox = overlay;
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					lightbox?.remove();
					lightbox = null;
				}
			});

			// 文章目录：窄屏用 <details> 折叠文字版，宽屏用左侧刻度；小球贴在正文标题旁
			const toc = document.querySelector('.toc');
			const tocDetails = toc?.querySelector('details');
			const wideToc = window.matchMedia('(min-width: 1200px)');
			const syncTocOpen = () => {
				if (tocDetails) tocDetails.open = !wideToc.matches;
			};
			syncTocOpen();
			wideToc.addEventListener('change', syncTocOpen);

			const headingBall = document.querySelector('.heading-ball');
			const ballDot = headingBall?.querySelector('.ball-dot');

			const tocLinks = Array.from(
				document.querySelectorAll('.toc a[href^="#"], .toc-tick a[href^="#"]'),
			)
				.map((link) => ({
					link,
					id: decodeURIComponent(link.getAttribute('href').slice(1)),
				}))
				.filter((item) => document.getElementById(item.id));

			// 同一小节可能在两套目录里各有链接，按 id 去重后统一处理
			const tocIds = [...new Set(tocLinks.map((item) => item.id))];

			if (tocIds.length) {
				let currentId = '';

				// 小球停在当前小节标题的左边；换小节时给一次落地回弹
				const moveBall = (id, animate) => {
					if (!headingBall) return;
					const heading = document.getElementById(id);
					const prose = heading?.closest('.prose');
					if (!heading || !prose) return;
					// 用 rect 差算相对 .prose 的坐标，比 offsetTop 稳（不受 offsetParent 影响）
					const top =
						heading.getBoundingClientRect().top -
						prose.getBoundingClientRect().top +
						heading.offsetHeight / 2 -
						headingBall.offsetHeight / 2;
					headingBall.style.transform = `translateY(${top}px)`;
					if (animate && ballDot) {
						ballDot.classList.remove('bounce');
						// 读一次布局属性，动画才能重新播放
						void ballDot.offsetWidth;
						ballDot.classList.add('bounce');
					}
				};

				const markActive = () => {
					// 判定线在视口中线：标题滚过一半，就算"当前小节"
					const anchorY = window.innerHeight / 2;
					let activeId = tocIds[0];
					tocIds.forEach((id) => {
						const heading = document.getElementById(id);
						if (heading && heading.getBoundingClientRect().top <= anchorY) activeId = id;
					});
					const changed = activeId !== currentId;
					if (changed) {
						currentId = activeId;
						tocLinks.forEach(({ link, id }) => link.classList.toggle('active', id === activeId));
					}
					moveBall(activeId, changed);
				};

				let queued = false;
				window.addEventListener(
					'scroll',
					() => {
						if (queued) return;
						queued = true;
						requestAnimationFrame(() => {
							markActive();
							queued = false;
						});
					},
					{ passive: true },
				);
				window.addEventListener('resize', markActive);
				// 字体加载完位置会变，重新量一次
				window.addEventListener('load', markActive);
				document.fonts?.ready.then(markActive);
				markActive();
			}

			// 阅读进度条：滚到哪儿，顶上那根青线就走到哪儿
			const progressBar = document.querySelector('.read-progress');
			if (progressBar) {
				let progressQueued = false;
				const syncProgress = () => {
					const max = document.documentElement.scrollHeight - window.innerHeight;
					const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
					progressBar.style.transform = `scaleX(${ratio})`;
				};
				window.addEventListener(
					'scroll',
					() => {
						if (progressQueued) return;
						progressQueued = true;
						requestAnimationFrame(() => {
							syncProgress();
							progressQueued = false;
						});
					},
					{ passive: true },
				);
				window.addEventListener('resize', syncProgress);
				syncProgress();
			}

			// 字号调节已于 2026-11-03 去掉：它和回顶按钮抢右下角，用户也不需要。
			// 顺手清掉旧版本留下的偏好，免得以后有人误读这个键
			try {
				localStorage.removeItem('readsize');
			} catch {
				/* 存储不可用就算了 */
			}
		</script>
	</body>
</html>
