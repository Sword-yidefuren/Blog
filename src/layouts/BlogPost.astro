---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { readingTime } from '../utils/readingTime';

type TocItem = { slug: string; text: string; level: 1 | 2 };

type Props = CollectionEntry<'blog'>['data'] & {
	body?: string;
	prev?: { id: string; title: string } | null;
	next?: { id: string; title: string } | null;
	toc?: TocItem[];
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], prev, next, toc = [] } = Astro.props;
const minutes = readingTime(Astro.props.body);
// 太短的文章不放目录（默认 3 条起）
const showToc = toc.length >= 3;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				author: { '@type': 'Person', name: 'Sword' },
				mainEntityOfPage: Astro.url.href,
			})}
		></script>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 750px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 0 1em 1em;
				color: rgb(var(--gray-dark));
			}
			/* 标题块从 .prose 里拆出来，手机端目录才能插在「标题之后、正文之前」 */
			.article-head {
				width: 750px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em 1em 0;
			}
			.article-body {
				display: block;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.reading-time {
				font-size: 0.9em;
				color: rgb(var(--gray));
				margin-top: 0.2em;
			}
			.last-updated-on {
				font-style: italic;
			}

			/* ---------- 文章目录 ---------- */
			.toc {
				width: 750px;
				max-width: calc(100% - 2em);
				margin: 1.4em auto;
				padding: 0 1em;
				font-size: 0.88em;
			}
			.toc details {
				padding: 0.7em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: rgb(var(--header-bg));
			}
			.toc summary {
				color: rgb(var(--gray-dark));
				font-weight: 700;
				line-height: 1.6;
				cursor: pointer;
			}
			.toc summary::marker {
				color: var(--accent);
			}
			.toc ol {
				list-style: none;
				margin: 0.5em 0 0.2em;
				padding: 0;
				border-left: 1px solid rgb(var(--gray-light));
			}
			.toc li a {
				display: block;
				margin-left: -1px;
				padding: 0.35em 0 0.35em 0.9em;
				border-left: 2px solid transparent;
				color: rgb(var(--gray));
				line-height: 1.5;
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.toc li.lvl-2 a {
				padding-left: 1.8em;
				font-size: 0.94em;
			}
			.toc li a:hover {
				color: var(--accent-text);
			}
			.toc li a.active {
				border-left-color: var(--accent);
				color: var(--accent-text);
			}
			/* 锚点跳转别被贴顶的标题挡住 */
			.prose :is(h2, h3, h4, h5, h6) {
				scroll-margin-top: 2em;
			}

			/* ---------- 左侧刻度目录 ---------- */
			.toc-tick {
				display: none;
				position: fixed;
				left: calc(50% - 375px - 76px);
				top: 50%;
				transform: translateY(-50%);
				z-index: 20;
			}
			.toc-tick ol {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: 10px;
				position: relative;
			}
			/* 轨道：一条极淡的竖线，刻度从它向左伸出 */
			.toc-tick ol::after {
				content: '';
				position: absolute;
				right: 0;
				top: 1px;
				bottom: 1px;
				width: 1px;
				background: rgb(var(--gray-light));
			}
			.toc-tick li {
				position: relative;
				z-index: 1;
			}
			.toc-tick a {
				display: flex;
				align-items: center;
				justify-content: flex-end;
				position: relative;
			}
			.tick {
				display: block;
				height: 2px;
				border-radius: 2px;
				background: rgb(var(--gray-light));
				transition:
					width 0.2s ease,
					background 0.2s ease;
			}
			.lvl-1 .tick {
				width: 16px;
			}
			.lvl-2 .tick {
				width: 10px;
			}
			.toc-tick a:hover .tick,
			.toc-tick a.active .tick {
				background: var(--accent);
			}
			.lvl-1 a.active .tick {
				width: 20px;
			}
			.lvl-2 a.active .tick {
				width: 14px;
			}
			/* 悬停/聚焦才浮出标题 */
			.toc-tick .label {
				position: absolute;
				right: 100%;
				margin-right: 12px;
				padding: 0.2em 0.6em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--header-bg);
				color: rgb(var(--gray-dark));
				font-size: 0.76em;
				line-height: 1.6;
				white-space: nowrap;
				opacity: 0;
				transform: translateX(4px);
				transition:
					opacity 0.18s ease,
					transform 0.18s ease;
				pointer-events: none;
			}
			.toc-tick a:hover .label,
			.toc-tick a:focus-visible .label {
				opacity: 1;
				transform: none;
			}
			/* 小球：跳到当前小节对应的刻度上 */
			.toc-tick .ball {
				position: absolute;
				right: -3px;
				top: 0;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--accent);
				box-shadow: 0 0 0 3px rgba(34, 211, 238, 14%);
				transform: translateY(0);
				transition: transform 0.3s ease;
				pointer-events: none;
			}
			@media (prefers-reduced-motion: reduce) {
				.toc-tick .ball {
					transition: none;
				}
			}

			/* 宽屏才启用刻度目录：正文回到单列居中，刻度浮在左侧留白里；
			   同时撤掉顶部进度条，任何宽度下只留一个进度指示 */
			@media (min-width: 1200px) {
				.toc {
					display: none;
				}
				.toc-tick {
					display: block;
				}
				.read-progress {
					display: none;
				}
			}

			/* ---------- 阅读进度条 ---------- */
			.read-progress {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 2px;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: 0 50%;
				z-index: 40;
			}

			/* ---------- 字号调节 ---------- */
			.read-tools {
				position: fixed;
				right: 1.2em;
				bottom: 4.4em;
				display: flex;
				gap: 0.3em;
				z-index: 10;
			}
			.read-tools button {
				width: 2.2em;
				height: 2.2em;
				padding: 0;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 50%;
				background: var(--header-bg);
				color: rgb(var(--gray));
				font: inherit;
				font-size: 0.82em;
				line-height: 1;
				cursor: pointer;
				transition: 0.2s ease;
			}
			.read-tools button:hover:not(:disabled) {
				border-color: var(--accent);
				color: var(--accent-text);
			}
			.read-tools button:disabled {
				opacity: 0.35;
				cursor: default;
			}

			/* 字号调节只作用在正文，标题不动 */
			.prose {
				font-size: calc(1em * var(--reading-size, 1));
			}

			@media print {
				.toc,
				.read-progress,
				.read-tools {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<div class="read-progress" aria-hidden="true"></div>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="article-body">
					<div class="article-head">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{minutes > 0 && (
									<div class="reading-time">
										约 {minutes} 分钟
									</div>
								)}
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
							{
								tags.length > 0 && (
									<div class="post-tags">
										{tags.map((tag) => (
											<a class="tag" href={`/tags/${tag}/`}>
												{tag}
											</a>
										))}
									</div>
								)
							}
						</div>
					</div>
					{
						showToc && (
							<aside class="toc" aria-label="文章目录">
								<details open>
									<summary>本文目录</summary>
									<ol>
										{toc.map((item) => (
											<li class:list={[`lvl-${item.level}`]}>
												<a href={`#${item.slug}`}>{item.text}</a>
											</li>
										))}
									</ol>
								</details>
							</aside>
						)
					}
					{
						showToc && (
							<nav class="toc-tick" aria-label="文章目录（刻度）">
								<ol>
									{toc.map((item) => (
										<li class:list={[`lvl-${item.level}`]}>
											<a href={`#${item.slug}`} aria-label={`跳到：${item.text}`}>
												<span class="tick" aria-hidden="true" />
												<span class="label" aria-hidden="true">
													{item.text}
												</span>
											</a>
										</li>
									))}
								</ol>
								<span class="ball" aria-hidden="true" />
							</nav>
						)
					}
					<div class="prose">
					<slot />
					{
						(prev || next) && (
							<nav class="post-nav" aria-label="上一篇与下一篇">
								{prev ? (
									<a class="prev" href={`/blog/${prev.id}/`}>
										<span class="dir">← 上一篇</span>
										<strong>{prev.title}</strong>
									</a>
								) : (
									<span />
								)}
								{next ? (
									<a class="next" href={`/blog/${next.id}/`}>
										<span class="dir">下一篇 →</span>
										<strong>{next.title}</strong>
									</a>
								) : (
									<span />
								)}
							</nav>
						)
					}
					</div>
				</div>
			</article>
		</main>
		<div class="read-tools" role="group" aria-label="字号调节">
			<button type="button" data-step="-1" aria-label="字号调小" title="字号调小">A−</button>
			<button type="button" data-step="1" aria-label="字号调大" title="字号调大">A+</button>
		</div>
		<Footer />
		<script>
			// 阅读续读：按滚动比例记录/恢复每篇文章的阅读进度
			const key = `readpos:${location.pathname}`;
			const store = {
				get() {
					try {
						return localStorage.getItem(key);
					} catch {
						return null;
					}
				},
				set(value) {
					try {
						localStorage.setItem(key, value);
					} catch {
						/* 存储不可用时忽略 */
					}
				},
				clear() {
					try {
						localStorage.removeItem(key);
					} catch {
						/* 同上 */
					}
				},
			};

			// 避免浏览器自带的滚动恢复与续读打架
			if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

			const saved = parseFloat(store.get() ?? '');
			if (!Number.isNaN(saved) && saved > 0.02 && saved < 0.95) {
				requestAnimationFrame(() => {
					const max = document.documentElement.scrollHeight - window.innerHeight;
					if (max > 0) {
						window.scrollTo({ top: saved * max, behavior: 'auto' });
						showResumeToast();
					}
				});
			}

			let timer = 0;
			const save = () => {
				const max = document.documentElement.scrollHeight - window.innerHeight;
				if (max <= 0) return;
				const ratio = window.scrollY / max;
				// 读到 95% 以上视为读完，清空记录，下次从头开始
				if (ratio > 0.95) store.clear();
				else if (ratio > 0.02) store.set(String(ratio));
			};
			window.addEventListener(
				'scroll',
				() => {
					clearTimeout(timer);
					timer = window.setTimeout(save, 300);
				},
				{ passive: true },
			);
			window.addEventListener('pagehide', save);

			function showResumeToast() {
				const toast = document.createElement('div');
				toast.className = 'read-resume-toast';
				const text = document.createElement('span');
				text.textContent = '已回到上次阅读位置';
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.textContent = '从头开始';
				btn.addEventListener('click', () => {
					window.scrollTo({ top: 0, behavior: 'smooth' });
					toast.remove();
				});
				toast.append(text, btn);
				document.body.appendChild(toast);
				window.setTimeout(() => toast.remove(), 6000);
			}

			// 回到顶部按钮：滚过一屏后出现
			const backTop = document.createElement('button');
			backTop.type = 'button';
			backTop.className = 'back-to-top';
			backTop.setAttribute('aria-label', '回到顶部');
			backTop.textContent = '↑';
			document.body.appendChild(backTop);
			const syncBackTop = () => backTop.classList.toggle('show', window.scrollY > 600);
			window.addEventListener('scroll', syncBackTop, { passive: true });
			syncBackTop();
			backTop.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// 图片灯箱：点正文里的图片放大，点任意处或 Esc 关闭
			let lightbox = null;
			document.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof HTMLImageElement)) return;
				if (!target.closest('.prose')) return;
				lightbox?.remove();
				const overlay = document.createElement('div');
				overlay.className = 'lightbox';
				overlay.setAttribute('role', 'dialog');
				overlay.setAttribute('aria-label', '查看大图');
				const big = new Image();
				big.src = target.currentSrc || target.src;
				big.alt = target.alt;
				overlay.appendChild(big);
				overlay.addEventListener('click', () => overlay.remove());
				document.body.appendChild(overlay);
				requestAnimationFrame(() => overlay.classList.add('show'));
				lightbox = overlay;
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					lightbox?.remove();
					lightbox = null;
				}
			});

			// 文章目录：窄屏用 <details> 折叠文字版，宽屏用左侧刻度 + 滑动小球
			const toc = document.querySelector('.toc');
			const tocDetails = toc?.querySelector('details');
			const wideToc = window.matchMedia('(min-width: 1200px)');
			const syncTocOpen = () => {
				if (tocDetails) tocDetails.open = !wideToc.matches;
			};
			syncTocOpen();
			wideToc.addEventListener('change', syncTocOpen);

			const tocTick = document.querySelector('.toc-tick');
			const tocBall = tocTick?.querySelector('.ball');

			const tocLinks = Array.from(
				document.querySelectorAll('.toc a[href^="#"], .toc-tick a[href^="#"]'),
			)
				.map((link) => ({
					link,
					id: decodeURIComponent(link.getAttribute('href').slice(1)),
				}))
				.filter((item) => document.getElementById(item.id));

			// 同一小节可能在两套目录里各有链接，按 id 去重后统一处理
			const tocIds = [...new Set(tocLinks.map((item) => item.id))];

			if (tocIds.length) {
				let currentId = '';
				const markActive = () => {
					let activeId = tocIds[0];
					tocIds.forEach((id) => {
						const heading = document.getElementById(id);
						if (heading && heading.getBoundingClientRect().top <= 120) activeId = id;
					});
					if (activeId === currentId) return;
					currentId = activeId;
					tocLinks.forEach(({ link, id }) => link.classList.toggle('active', id === activeId));

					// 小球跳到当前刻度上
					const activeLink = Array.from(tocTick?.querySelectorAll('a') ?? []).find(
						(link) => decodeURIComponent(link.getAttribute('href').slice(1)) === activeId,
					);
					if (tocBall && activeLink) {
						const top = activeLink.parentElement.offsetTop + activeLink.offsetHeight / 2 - 3;
						tocBall.style.transform = `translateY(${top}px)`;
					}
				};

				let queued = false;
				window.addEventListener(
					'scroll',
					() => {
						if (queued) return;
						queued = true;
						requestAnimationFrame(() => {
							markActive();
							queued = false;
						});
					},
					{ passive: true },
				);
				window.addEventListener('resize', markActive);
				markActive();
			}

			// 阅读进度条：滚到哪儿，顶上那根青线就走到哪儿
			const progressBar = document.querySelector('.read-progress');
			if (progressBar) {
				let progressQueued = false;
				const syncProgress = () => {
					const max = document.documentElement.scrollHeight - window.innerHeight;
					const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
					progressBar.style.transform = `scaleX(${ratio})`;
				};
				window.addEventListener(
					'scroll',
					() => {
						if (progressQueued) return;
						progressQueued = true;
						requestAnimationFrame(() => {
							syncProgress();
							progressQueued = false;
						});
					},
					{ passive: true },
				);
				window.addEventListener('resize', syncProgress);
				syncProgress();
			}

			// 字号调节：0.9 / 1 / 1.1 / 1.2 倍，记在 localStorage
			const sizeSteps = [0.9, 1, 1.1, 1.2];
			const sizeKey = 'readsize';
			let sizeIndex = 1;
			try {
				const savedIndex = sizeSteps.indexOf(Number(localStorage.getItem(sizeKey)));
				if (savedIndex >= 0) sizeIndex = savedIndex;
			} catch {
				/* 存储不可用就用默认字号 */
			}

			const sizeButtons = document.querySelectorAll('.read-tools [data-step]');
			const applySize = () => {
				document.documentElement.style.setProperty('--reading-size', String(sizeSteps[sizeIndex]));
				sizeButtons.forEach((btn) => {
					const step = Number(btn.dataset.step);
					btn.disabled = step < 0 ? sizeIndex === 0 : sizeIndex === sizeSteps.length - 1;
				});
			};

			sizeButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const step = Number(btn.dataset.step);
					sizeIndex = Math.min(sizeSteps.length - 1, Math.max(0, sizeIndex + step));
					applySize();
					try {
						localStorage.setItem(sizeKey, String(sizeSteps[sizeIndex]));
					} catch {
						/* 忽略 */
					}
				});
			});
			applySize();
		</script>
	</body>
</html>
